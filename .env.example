# Copy to .env and adjust for your local environment.
# .env is git-ignored; never commit real secrets.
#
# Grouped per docs/DEPLOYMENT_ENV.md: APP / DATABASE / AUTH / STORAGE / EMAIL / JOBS /
# WEBHOOK. Every value below is a placeholder — LOCAL/TEST values are safe-to-commit
# examples that only work against your own machine; REMOTE DEMO values must be generated
# fresh per docs/DEPLOYMENT_ENV.md and stored only in Render's environment-variable
# dashboard, never in this file or any commit.

# =====================================================================
# APP
# =====================================================================

# Unset/anything-but-"production" = local dev conveniences stay active (password-reset and
# parent-invitation endpoints return their raw token in the API response instead of relying
# on an email you haven't configured — see AuthService.requestPasswordReset). MUST be set
# to exactly "production" in every real deployment, or those dev-only token leaks stay
# live. main.ts's assertProductionConfigSafe() refuses to start when NODE_ENV=production
# and any secret below is still a placeholder — see docs/production/SECURITY_BASELINE.md.
NODE_ENV=development

# Render injects PORT itself and expects the app to listen on it — main.ts reads
# `process.env.PORT ?? process.env.API_PORT ?? 3000`, so PORT (if set) always wins. Leave
# PORT unset locally and use API_PORT instead (kept for backward compatibility with every
# doc/script written before this project targeted Render).
PORT=
API_PORT=3000
API_REQUEST_ID_HEADER=x-request-id

# Informational only — nothing in this backend-only repository currently reads these two;
# they exist so a deployment's env-var set has a single documented place to record its own
# public URLs (used when configuring Render/a future frontend/webhook callback URLs by
# hand). Not required for the API to boot or function.
API_URL=http://localhost:3000
FRONTEND_URL=

# Comma-separated browser origins allowed to call this API cross-origin (e.g.
# "https://app.example.com,https://admin.example.com" — typically the same value as
# FRONTEND_URL above once a frontend exists). Empty/unset = CORS closed entirely (no
# browser origin allowed) — safe default until a frontend is deployed. Never "*": the
# refresh-token cookie flow uses credentials:true, which is invalid combined with a
# wildcard origin, and assertProductionConfigSafe() rejects a wildcard here outright when
# NODE_ENV=production.
CORS_ALLOWED_ORIGINS=

# General API rate limiting (NFR-SEC-06), per IP. POST /auth/login carries its own tighter
# override on top of this (see AuthController). Ignored entirely when NODE_ENV=test.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# =====================================================================
# DATABASE (Supabase PostgreSQL for remote — see docs/DEPLOYMENT_ENV.md "Database")
# =====================================================================

DATABASE_URL="postgresql://abroad_app:abroad_app_dev_password@localhost:55432/abroad_scholarship_dev?schema=public"
# Local dev has no connection pooler — same connection as DATABASE_URL. On Supabase:
# DATABASE_URL should be the Transaction pooler string (port 6543, add
# "&sslmode=require" — do not rely on the default "prefer", which silently allows a
# plaintext fallback); DIRECT_URL should be the Session pooler string (port 5432, add
# "?sslmode=require") if your network has no IPv6 route to Supabase's true Direct
# Connection endpoint (Supabase's own documented IPv4-compatible alternative — this is
# the common case), or the actual Direct Connection string if it does. Prisma's migration
# engine needs the non-transaction-pooled connection for DDL. Percent-encode any reserved
# character (notably "@") inside the password itself, or the URI parser will misread where
# the credentials end and the host begins. See schema.prisma's datasource comment and
# docs/DEPLOYMENT_ENV.md "Database" for the full reasoning.
DIRECT_URL="postgresql://abroad_app:abroad_app_dev_password@localhost:55432/abroad_scholarship_dev?schema=public"

# =====================================================================
# AUTH (03-security/01_AUTH.md)
# =====================================================================

# JWT signing secret for the (short-lived) access token. Never log this value. (This is
# the project's one "session-shaped" secret — there is no separate SESSION_SECRET: refresh
# sessions are database rows re-validated per request, not a second signed-cookie scheme —
# see docs/security/AUTH_MODEL.md.)
AUTH_JWT_SECRET=change-me-in-phase-03
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Required only when NODE_ENV=production, for the ONE unconditional bootstrap seed step
# (database/seeds/seed.ts creates a single SYSTEM_ADMIN "admin" user in every environment;
# every other seeded user is a NODE_ENV!=='production'-only fixture). The seed script
# refuses to run in production without this — it never falls back to its dev-only default
# password ('ChangeMe!123').
BOOTSTRAP_ADMIN_PASSWORD=
# AES-256-GCM key (32 raw bytes) used only to encrypt/decrypt stored TOTP secrets at rest.
# Deliberately separate from AUTH_JWT_SECRET (different blast radius if leaked). This
# EXACT value is a committed, publicly-known example — copy it for local dev only; it is
# explicitly rejected at startup if NODE_ENV=production (see assert-production-config.ts).
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_MFA_ENCRYPTION_KEY=a73f7fd82e8c3dfbbe66f845d2020c26996816e8aefe75d189e9388fb0d8645b
AUTH_MFA_ISSUER="Abroad Scholarship System"
# Cookies default to Secure; set to false only for local http:// development.
AUTH_COOKIE_SECURE=false

# --- Idempotency ---
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Commercial (05-commercial) ---
# SRS 6.16 "Approval theo monetary threshold" — Contract value at/above this amount
# requires EXECUTIVE_DIRECTOR approval regardless of who else holds contracts:approve.
CONTRACT_APPROVAL_THRESHOLD_AMOUNT=5000
# SRS 6.16 "secure link có expiry" — how long a Contract review link stays valid after
# POST /contracts/:id/send.
CONTRACT_REVIEW_LINK_TTL_HOURS=72

# =====================================================================
# STORAGE (local disk for dev/test; Cloudflare R2 for remote — see
# docs/DEPLOYMENT_ENV.md "Storage")
# =====================================================================

# "local" (default) or "r2". Render's free-tier filesystem is ephemeral — local storage
# loses every document on the next deploy/restart there, so REMOTE DEMO must use "r2".
# assertProductionConfigSafe() refuses to boot with NODE_ENV=production and this still
# "local"/unset. See apps/api/src/common/storage/storage.module.ts.
STORAGE_PROVIDER=local

# Private, non-web-served directory the default LocalFilesystemStorageProvider writes
# uploaded document bytes to. Relative to the api process's cwd unless absolute. Only used
# when STORAGE_PROVIDER=local.
DOCUMENT_STORAGE_DIR=storage/documents

# Only used when STORAGE_PROVIDER=r2. R2StorageProvider (apps/api/src/common/storage/
# r2-storage.provider.ts) is S3-API-compatible — validated locally against MinIO (see
# docker-compose.test.yml), no real Cloudflare credentials required for that validation.
# For a real deployment: create an R2 bucket + API token in the Cloudflare dashboard (not
# performed by this repository) and fill these in as real deployment secrets, never here.
R2_ACCOUNT_ID=
# Either R2_ACCOUNT_ID (endpoint is derived as https://<account_id>.r2.cloudflarestorage.com)
# or R2_ENDPOINT directly (e.g. for pointing at a local MinIO emulator: http://localhost:9000)
# — at least one is required when STORAGE_PROVIDER=r2.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# HMAC secret signing short-lived document download tokens. Never log this value. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_SIGNING_SECRET=change-me-in-phase-12
# How long a signed download URL stays valid after GET /documents/:id/download.
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=60
# Maximum accepted upload size, in bytes (default 25 MB).
DOCUMENT_MAX_SIZE_BYTES=26214400

# =====================================================================
# EMAIL (adapter architecture — apps/api/src/common/integrations/)
# =====================================================================

# Only "log" is implemented in this repository (LogEmailProvider — logs recipient/event/
# subject only, never the body, and reports success; see docs/ASSUMPTIONS.md ASM-52/54).
# EMAIL_FROM/EMAIL_API_KEY are reserved, documented placeholders for a future real provider
# (SES/Resend/SendGrid/etc.) to be wired behind the existing EmailProvider interface — see
# docs/DEPLOYMENT_ENV.md "Email" for exactly what that swap involves. No real credentials
# are required or consumed by this repository today.
EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_API_KEY=

# =====================================================================
# JOBS / SCHEDULER (12-platform) — run in-process, same instance as the web server;
# no separate worker process/dyno exists or is needed.
# =====================================================================

# How often (ms) the in-process background-job worker polls for due jobs.
JOB_POLL_INTERVAL_MS=5000
# How often (ms) the scheduler enqueues due recurring jobs (reminder sweeps, external sync).
SCHEDULER_INTERVAL_MS=60000

# =====================================================================
# WEBHOOK
# =====================================================================

# HMAC secret verifying inbound e-signature provider webhook signatures. Unset/empty means
# every webhook delivery is rejected (fails closed, never fails open).
ESIGN_WEBHOOK_SECRET=change-me-in-phase-12
