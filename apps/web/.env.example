# Copy to .env.local and adjust for your environment. Never commit real values.

# Base URL (or same-origin proxy path) the browser sends API requests to. No trailing slash.
# Never hard-code the Render deployment URL.
#
# LOCAL DEV (default, unchanged since F02): point this directly at the locally-running
# backend. `npm run web:dev` runs this app on port 3001 (apps/api/main.ts defaults to 3000)
# specifically so both can run side by side without colliding. For the httpOnly refresh-token
# cookie / CORS credentials flow to work against a locally-running backend, its
# CORS_ALLOWED_ORIGINS must include this app's exact origin (http://localhost:3001) — see
# docs/frontend/FRONTEND_AUTH.md "Local development: CORS".
NEXT_PUBLIC_API_URL=http://localhost:3000

# PRODUCTION/DEMO (F11A same-origin proxy — see docs/frontend/FRONTEND_DEPLOYMENT_RUNBOOK.md
# "Same-origin API proxy"): set this to the relative path "/api" instead, and set the
# server-only API_PROXY_TARGET (below, NOT NEXT_PUBLIC_-prefixed) to the real backend origin.
# The browser then only ever talks to this app's own origin — Next.js's own rewrites() proxies
# /api/* to the real backend server-side. This keeps the refresh cookie's SameSite=Strict
# policy working correctly (a cross-origin frontend/backend pair would otherwise silently
# break session-restore/refresh — see docs/frontend/FRONTEND_AUTH.md §13).
#
# NEXT_PUBLIC_API_URL=/api

# Server-only — never read by any client-side code, never inlined into the browser bundle.
# Only meaningful together with NEXT_PUBLIC_API_URL=/api above; unset (as it is by default,
# for local dev) means no /api/* proxy rewrite is registered at all.
#
# API_PROXY_TARGET=https://abroad-scholarship-system.onrender.com
